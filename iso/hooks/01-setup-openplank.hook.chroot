#!/bin/bash
# openPlank OS — Post-Install Hook
# Runs inside the chroot during ISO build

set -e

echo "🔧 openPlank OS Setup..."

# === Create openplank user ===
useradd -m -s /bin/bash -G sudo,audio,video,plugdev,netdev,lpadmin openplank
echo "openplank:openplank" | chpasswd
echo "openplank ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/openplank

# === Install Node.js 22 LTS (if not from repo) ===
if ! command -v node &>/dev/null || [[ "$(node -v)" < "v20" ]]; then
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
    apt-get install -y nodejs
fi

# === PostgreSQL auto-start ===
systemctl enable postgresql

# === Create openplank database ===
su - postgres -c "createuser -s openplank 2>/dev/null || true"
su - postgres -c "createdb -O openplank openplank 2>/dev/null || true"

# === Clone openplank-dent ===
mkdir -p /opt/openplank
git clone --depth 1 https://github.com/openplank-dev/openplank-dent.git /opt/openplank/app || true
cd /opt/openplank/app/server
npm install --production 2>/dev/null || true

# === Ollama (optional, large) ===
# Uncomment to include Ollama in the ISO:
# curl -fsSL https://ollama.com/install.sh | sh
# systemctl enable ollama

# === Plymouth boot splash ===
if [ -d /usr/share/plymouth/themes ]; then
    mkdir -p /usr/share/plymouth/themes/openplank
    cp /opt/openplank-os-branding/plymouth/* /usr/share/plymouth/themes/openplank/ 2>/dev/null || true
fi

# === Auto-login (no display manager, straight to openbox+chromium) ===
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf << 'UNIT'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin openplank --noclear %I $TERM
UNIT

# === .bash_profile: auto-start X on tty1 ===
cat > /home/openplank/.bash_profile << 'PROFILE'
if [ -z "$DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
    exec startx -- -nocursor 2>/dev/null
fi
PROFILE
chown openplank:openplank /home/openplank/.bash_profile

# === Openbox autostart: Chromium kiosk ===
mkdir -p /home/openplank/.config/openbox
cat > /home/openplank/.config/openbox/autostart << 'AUTOSTART'
#!/bin/bash
# Wait for openPlank server
echo "⏳ Waiting for openPlank server..."
for i in $(seq 1 30); do
    curl -s http://localhost:3001/api/v1/health >/dev/null 2>&1 && break
    sleep 1
done

# Launch Chromium in kiosk mode
chromium \
    --kiosk \
    --no-first-run \
    --disable-translate \
    --disable-infobars \
    --disable-suggestions-service \
    --disable-save-password-bubble \
    --disable-session-crashed-bubble \
    --noerrdialogs \
    --disk-cache-size=0 \
    --user-data-dir=/home/openplank/.chromium-kiosk \
    http://localhost:3001
AUTOSTART
chmod +x /home/openplank/.config/openbox/autostart
chown -R openplank:openplank /home/openplank/.config

# === systemd service for openPlank server ===
cat > /etc/systemd/system/openplank.service << 'SERVICE'
[Unit]
Description=openPlank Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=openplank
WorkingDirectory=/opt/openplank/app/server
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=DATABASE_URL=postgresql://openplank:openplank@localhost/openplank

[Install]
WantedBy=multi-user.target
SERVICE

systemctl enable openplank.service

# === Hostname ===
echo "openplank" > /etc/hostname

# === MOTD ===
cat > /etc/motd << 'MOTD'

  ╔═══════════════════════════════════════╗
  ║         openPlank OS v0.1.0           ║
  ║    KI Desktop Environment für         ║
  ║         Arztpraxen                    ║
  ╚═══════════════════════════════════════╝

  Admin UI:  http://localhost:3001/admin
  Client UI: http://localhost:3001

MOTD

echo "✅ openPlank OS Setup complete."
