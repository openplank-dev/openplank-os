[Unit]
Description=openPlank Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=openplank
WorkingDirectory=/opt/openplank/app/server
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=DATABASE_URL=postgresql://openplank:openplank@localhost/openplank

[Install]
WantedBy=multi-user.target
